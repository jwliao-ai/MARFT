# hp_sweep_configs.env — HP grid values for MARFT hyperparameter sweep
#
# Sourced by run_hp_sweep.sh.  Each array defines the values swept for
# a single hyperparameter in the corresponding phase.
#
# Total experiments: 180  (48 + 16 + 32 + 16 + 16 + 24 + 28)

# ── Phase 1A: Learning rate × PPO clip ratio (48 experiments) ────────────
P1A_LR_VALUES=(1e-6 5e-6 1e-5 2e-5)
P1A_CLIP_VALUES=(0.1 0.2 0.3)

# ── Phase 1B: KL coefficient (16 experiments) ───────────────────────────
P1B_KL_VALUES=(0.0 0.01 0.05 0.1)

# ── Phase 2A: Reward scaling × reward bias (32 experiments) ─────────────
P2A_RS_VALUES=(0.5 1.0 2.0 5.0)
P2A_RB_VALUES=(0.0 -0.5)

# ── Phase 2B: GAE parameters (16 experiments) ──────────────────────────
P2B_DISCOUNT_VALUES=(0.99 1.0)
P2B_LAMBDA_VALUES=(0.95 1.0)

# ── Phase 3A: Temperature (16 experiments) ──────────────────────────────
P3A_TEMP_VALUES=(0.7 0.8 1.0 1.2)

# ── Phase 3B: LoRA rank/alpha combinations (24 experiments) ─────────────
# Format: "rank alpha" (space-separated pairs)
P3B_LORA_CONFIGS=("16 8" "32 16" "64 32" "32 32" "64 64" "16 16")

# ── Phase 4A: Seed robustness (8 experiments) ──────────────────────────
P4A_SEEDS=(1 42)

# ── Default HP values (used for Phase 4D ablation resets) ───────────────
DEFAULT_LR=5e-6
DEFAULT_CLIP=0.2
DEFAULT_KL=0.1
DEFAULT_RS=1.0
DEFAULT_RB=0.0
DEFAULT_DISCOUNT=1.0
DEFAULT_LAMBDA=1.0
DEFAULT_TEMP=1.0
DEFAULT_LORA_RANK=32
DEFAULT_LORA_ALPHA=16
